{
	"name": "@ft_transcendence/server",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
		"start": "node dist/server.js",
		"lint": "eslint .",
		"test": "vitest run --maxWorkers=1 --watch",
		"test:coverage": "vitest run --coverage --maxWorkers=1 --watch",
		"test:unit": "vitest run tests/unit --watch",
		"test:unit-nowatch": "vitest run tests/unit",
		"test:integration": "vitest run tests/integration --maxWorkers=1 --watch",
		"postinstall": "prisma generate || true"
	},
	"dependencies": {
		"@ft_transcendence/shared": "*",
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"bcryptjs": "^3.0.3",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"express": "^5.2.1",
		"jsonwebtoken": "^9.0.3",
		"pg": "^8.22.0"
	},
	"devDependencies": {
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^25.9.1",
		"@types/pg": "^8.20.0",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.4.1",
		"prisma": "^7.9.1",
		"supertest": "^7.2.2",
		"tsc-alias": "^1.8.17",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11"
	}
}
