generator client {
	provider = "prisma-client"
	output   = "../src/generated/prisma"
}

datasource db {
	provider = "postgresql"
}

enum GameMode {
	SOLO
	DUO
}

enum GameStatus {
	PENDING
	IN_PROGRESS
	FINISHED
}

enum FriendshipStatus {
	PENDING
	ACCEPTED
}

model User {
	uuid				String			@id @default(uuid()) @db.Uuid
	email				String			@unique
	username			String			@unique
	password			String
	createdAt			DateTime		@default(now())
	avatarPath			String?

	participations		UserOnGame[]

	friendshipsSent		Friendship[]	@relation("FriendshipSender")
	friendshipsReceived	Friendship[]	@relation("FriendshipReceiver")

	messagesSent		Message[]		@relation("MessageSender")
	messagesReceived	Message[]		@relation("MessageReceiver")
}

model Game {
	uuid			String			@id @default(uuid(7)) @db.Uuid
	mode			GameMode		@default(SOLO)
	status			GameStatus		@default(PENDING)
	duration		Int				@default(0)
	participants	UserOnGame[]
}

model UserOnGame {
	id		Int		@id @default(autoincrement())
	userId	String	@db.Uuid
	gameId	String	@db.Uuid
	score	Int		@default(0)

	user	User	@relation(fields: [userId], references: [uuid], onDelete: Cascade)
	game	Game	@relation(fields: [gameId], references: [uuid], onDelete: Cascade)

	@@unique([userId, gameId])
	@@index([userId])
	@@index([gameId])
}

model Friendship {
	uuid		String				@id @default(uuid(7)) @db.Uuid
	senderId	String				@db.Uuid
	receiverId	String				@db.Uuid
	status		FriendshipStatus	@default(PENDING)

	sender		User				@relation("FriendshipSender", fields: [senderId], references: [uuid], onDelete: Cascade)
	receiver	User				@relation("FriendshipReceiver", fields: [receiverId], references: [uuid], onDelete: Cascade)

	@@unique([senderId, receiverId])
	@@index([uuid])
	@@index([senderId, status])
	@@index([receiverId, status])
}

model Message {
	uuid		String	@id @default(uuid(7)) @db.Uuid
	senderId	String	@db.Uuid
	receiverId	String	@db.Uuid
	content		String

	sender		User	@relation("MessageSender", fields: [senderId], references: [uuid], onDelete: Cascade)
	receiver	User	@relation("MessageReceiver", fields: [receiverId], references: [uuid], onDelete: Cascade)
}
