{
	"name": "ft_transcendence",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev:shared": "npm run dev -w @ft_transcendence/shared",
		"dev:server": "npm run dev -w @ft_transcendence/server",
		"dev:web": "npm run dev -w @ft_transcendence/web",
		"dev": "npm run build -w @ft_transcendence/shared && concurrently -k \"npm run dev:shared\" \"npm run dev:server\" \"npm run dev:web\"",
		"build": "npm run build -w @ft_transcendence/shared && npm run build -w @ft_transcendence/server && npm run build -w @ft_transcendence/web",
		"start": "npm run start -w @ft_transcendence/server",
		"test:server": "npm run test -w @ft_transcendence/server",
		"lint": "npm run lint --workspaces --if-present",
		"format": "prettier --write .",
		"prepare": "husky"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"@prisma/engines@7.9.1": true,
		"prisma@7.9.1": true
	},
	"devDependencies": {
		"@types/bcryptjs": "^2.4.6",
		"@types/multer": "^2.2.0",
		"@types/uuid": "^10.0.0",
		"@types/ws": "^8.18.1",
		"concurrently": "^8.2.2",
		"prettier": "^3.8.3"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.9.1",
		"bcryptjs": "^3.0.3",
		"dotenv": "^17.4.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"multer": "^2.3.0",
		"react-hook-form": "^7.87.0",
		"uuid": "^14.0.1",
		"ws": "^8.21.3",
		"zod": "^4.5.4"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint",
			"prettier --write"
		],
		"*.{json,md,yml,yaml,css,scss}": [
			"prettier --write"
		]
	}
}
